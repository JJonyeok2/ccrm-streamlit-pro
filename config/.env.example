# Streamlit-only runtime configuration.
# Copy to config/.env for local use. Do not put secrets in this file.

# Local host URLs for running Streamlit directly on the host.
PIPELINE_API_BASE_URL=http://localhost:18000
MLFLOW_TRACKING_URI=http://localhost:15000
MLFLOW_EXPERIMENT_NAME=ccrm_experiment

# Docker Compose maps host STREAMLIT_HOST_PORT to container STREAMLIT_SERVER_PORT.
STREAMLIT_SERVER_PORT=8501
STREAMLIT_HOST_PORT=18501

# Docker Desktop containers should use host.docker.internal to reach services
# published on the host. Override these if using a shared Docker network.
DOCKER_PIPELINE_API_BASE_URL=http://host.docker.internal:18000
DOCKER_MLFLOW_TRACKING_URI=http://host.docker.internal:15000
